# =====================================================================
# El repo trabaja contra DOS entornos, en archivos distintos:
#
#   .env.local        → Supabase LOCAL (Docker). Lo que usa `npm run dev`.
#   .env.produccion   → credenciales reales. Next NO lo carga solo.
#
# Que apuntar a producción exija un `cp` a mano es deliberado: el
# desarrollo diario no debería poder tocar datos de clientes por accidente.
# =====================================================================

# --- Para .env.local (desarrollo) ---
# Los valores salen de: supabase status -o env
# No son secretos: son las llaves de demo de toda instalación local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Para .env.produccion ---
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # IGNORA la RLS. Solo webhooks y workers.
