# =====================================================================
# Variables del CRM. Copia este archivo y rellénalo; nunca subas uno con
# valores reales.
#
# LOS ARCHIVOS DE ENTORNO EN LOCAL
#   .env.desarrollo   → Supabase LOCAL (Docker, http://127.0.0.1:54321)
#   .env.produccion   → el proyecto real de Supabase
#   .env.local        → el ACTIVO: Next lo carga solo. Se cambia de
#                       entorno copiando uno de los dos de arriba encima.
# Ojo: si .env.local es una copia de .env.produccion, `npm run dev` lee
# datos reales de clientes.
#
# EN VERCEL (producción)
# Se ponen en Project → Settings → Environment Variables. Solo hacen
# falta las cuatro de abajo, y dos de ellas solo cuando el canal de
# WhatsApp esté vivo.
# =====================================================================

# --- Siempre ---
# Supabase → Project Settings → API. La anon key es pública por diseño:
# lo que protege los datos es la RLS, no esta llave.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo cuando el canal de WhatsApp esté vivo ---
# Sin estas dos, el CRM funciona entero y el botón de enviar se queda
# apagado diciendo por qué (lib/canal.ts → canalConfigurado()).
# PLATAFORMA_URL: la URL de la plataforma, sin barra final.
# CRM_ENVIO_TOKEN: un secreto largo y aleatorio, EL MISMO que tenga la
# plataforma en su variable CRM_ENVIO_TOKEN. Es lo único que deja al CRM
# pedirle envíos.
PLATAFORMA_URL=
CRM_ENVIO_TOKEN=

# --- NO va en Vercel ---
# La service role ignora la RLS. Hoy ningún camino del CRM la usa
# (lib/supabase/admin.ts existe pero nadie lo llama), así que no hay por
# qué darle al despliegue una llave que se salta todos los permisos.
# Solo para scripts locales, si algún día hacen falta.
# SUPABASE_SERVICE_ROLE_KEY=
