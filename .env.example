# Supabase — MISMO proyecto que CumbresStateInventory.
# El CRM comparte base de datos y Auth con la plataforma; lo que cambia es
# que sus tablas viven en el esquema `crm`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: IGNORA la RLS. Solo para webhooks y workers.
# Nunca debe llegar al navegador ni usarse para servir una petición de UI.
SUPABASE_SERVICE_ROLE_KEY=
